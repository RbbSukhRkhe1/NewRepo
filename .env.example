NODE_ENV=development
PORT=3847
SESSION_SECRET=replace_with_random_64_char_secret

# DB mode
USE_SUPABASE=false
DUAL_WRITE_SQLITE=false
SQLITE_PATH=server/data/donate.db

# Local Anvil chain
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_WS_URL=ws://127.0.0.1:8545
ANVIL_MNEMONIC="test test test test test test test test test test test junk"

# Supabase (free tier)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contract + Base Sepolia
CHAIN_TX_MODE=eoa
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VAULT_CONTRACT_ADDRESS=0xYourVaultContractAddress
BASESCAN_API_KEY=your_basescan_api_key
PRIVATE_KEY=0xyour_private_key
VAULT_ASSET_ADDRESS=0x0000000000000000000000000000000000000000

# Account abstraction (donor gasless path on Base Sepolia vault)
USE_USEROP=false

# Privy (frontend + verify on API) — optional; omit VITE_PRIVY_APP_ID to stay on cookie auth only
VITE_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Pimlico — optional; enables POST /api/aa/rpc proxy (auth required). Privy sponsor:true can work without this.
PIMLICO_API_KEY=your_pimlico_api_key