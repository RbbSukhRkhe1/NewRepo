# Copy to `.env` in the repository root (next to `docker-compose.yml`).
# Docker Compose loads this file automatically for ${VAR} substitution in compose.
# Do not commit a real `.env` with production secrets.

# --- Host port mappings ---
WEB_HOST_PORT=8080
API_HOST_PORT=3847
ANVIL_HOST_PORT=8545

# --- Backend (passed via compose `environment`) ---
# SESSION_SECRET=generate-a-long-random-string
# REDIS_URL=redis://redis:6379
# REDIS_DISABLED=
# REDIS_EVENTS_CHANNEL=vaultex:events
# ANVIL_RPC_URL=http://anvil:8545
# ANVIL_WS_URL=ws://anvil:8545
# VAULTEX_VAULT_ADDRESS=
# READY_SKIP_RPC=1
