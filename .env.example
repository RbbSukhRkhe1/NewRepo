# Copy to `.env` in the repository root (next to `docker-compose.yml`).
# Docker Compose loads this file automatically for ${VAR} substitution in compose.
# Do not commit a real `.env` with production secrets.

# --- Host port mappings ---
WEB_HOST_PORT=8080
API_HOST_PORT=3847
ANVIL_HOST_PORT=4585

# Anvil should be deterministic/immutable across deploys.
# (Compose does not persist chain state; these values ensure the same accounts/chainId every boot.)
ANVIL_CHAIN_ID=31337
ANVIL_ACCOUNTS=10
ANVIL_MNEMONIC=test test test test test test test test test test test junk
ANVIL_STATE_INTERVAL_SECS=5

# NETWORK=anvil
# NETWORK=sepolia
# SEPOLIA_RPC_URL=
# SEPOLIA_WS_URL=

# REDIS_URL=redis://redis:6379
# REDIS_DISABLED=
# REDIS_EVENTS_CHANNEL=vaultex:events
# ANVIL_RPC_URL=http://anvil:8545
# ANVIL_WS_URL=ws://anvil:8545
# VAULTEX_VAULT_ADDRESS=
# READY_SKIP_RPC=1

# Required on any shared / production host (bootstrap generates one in server .env)
# SESSION_SECRET=change-me-to-a-long-random-string
