# Copy to .env in this directory (backend/) for local overrides.
# For **Docker Compose**, use a `.env` at the **repository root** (see root `.env.example`).
# Never commit real .env files with secrets.

# Target chain for RPC + watcher (server-side donate still uses the dev HD wallet — see README).
NETWORK=anvil
# NETWORK=sepolia

# When NETWORK=sepolia — set a reliable HTTP RPC (code falls back to a public endpoint with rate limits if unset)
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# SEPOLIA_WS_URL=wss://ethereum-sepolia-rpc.publicnode.com

# API listen port (must match frontend/vite proxy if you change it)
# PORT=3847

# SQLite database file (default: server/data/donate.db next to server code)
# SQLITE_PATH=

# Local chain — HTTP JSON-RPC (default http://127.0.0.1:8545)
# ANVIL_RPC_URL=http://127.0.0.1:8545

# WebSocket URL for the block watcher (default: http(s) -> ws(s) from ANVIL_RPC_URL)
# ANVIL_WS_URL=ws://127.0.0.1:8545

# Redis (pub/sub for inter-service events — start with: docker compose up -d redis)
# REDIS_URL=redis://localhost:6379
# REDIS_EVENTS_CHANNEL=vaultex:events
# REDIS_DISABLED=1

# Session signing — REQUIRED in production (weak defaults are rejected at startup)
# SESSION_SECRET=replace-with-long-random-string

# Behind HTTPS reverse proxy (e.g. vaultex.club) — enables Secure session cookies in production
# USE_HTTPS=1

# Optional — skip JSON-RPC check on GET /ready (API-only or no chain in CI)
# READY_SKIP_RPC=1

# Optional — deployed VaultexVault.sol (see root README Foundry section). Not yet read by the API.
# VAULTEX_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
