# Copy to /etc/vaultex/api.env on the server (bootstrap-native does this once).
# Native stack: nginx + Node + Anvil (no Docker). Redis optional — disabled here to save RAM.

NODE_ENV=production
PORT=3847

SQLITE_PATH=/var/lib/vaultex/donate.db
SESSION_SECRET=replace-with-openssl-rand-hex-32

NETWORK=anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_WS_URL=ws://127.0.0.1:8545

# Pub/sub only — donate/ledger work without Redis
REDIS_DISABLED=1

# Leave unset so GET /ready checks Anvil (systemd vaultex-anvil must be running)
# READY_SKIP_RPC=1

# Optional: public testnet instead of local Anvil
# NETWORK=sepolia
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
