{
  "name": "live-tx-ledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3",
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "preview": "npm run preview -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "regression": "node scripts/regression.mjs",
    "simulate:donations": "node scripts/simulate-live-donations.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
